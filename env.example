# Configure in Vercel → Project Settings → Environment Variables
PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app
SESSION_SECRET=generate-a-random-secret-at-least-32-characters
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN
DISCORD_CLIENT_ID=YOUR_DISCORD_OAUTH_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_OAUTH_CLIENT_SECRET
# Optional, only if retaining the Discord slash-command endpoint
DISCORD_PUBLIC_KEY=
